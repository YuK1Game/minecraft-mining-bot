# Local account label; this is not your email or Xbox gamertag.
BOT_PROFILE=main
# Leave blank to select a Realm interactively each time.
REALM_ID=
# Leave blank to use the library default and server version discovery.
# If needed, use the supported protocol spelling, for example 1.26.51.
MINECRAFT_VERSION=
# The status API listens on 127.0.0.1 only.
API_PORT=3000

# Optional CloudWatch Logs. Both dedicated keys are required; blank keeps it off.
# Standard AWS_* credentials and shared AWS profiles are not used.
# Create the log group and stream in AWS first. See docs/cloudwatch-logs.md.
CLOUDWATCH_ACCESS_KEY_ID=
CLOUDWATCH_SECRET_ACCESS_KEY=
# Only required for temporary AWS credentials.
CLOUDWATCH_SESSION_TOKEN=
CLOUDWATCH_REGION=ap-northeast-1
CLOUDWATCH_LOG_GROUP=/minecraft-bot/personal
# Blank uses <hostname>/<BOT_PROFILE>, for example STORM/main.
CLOUDWATCH_LOG_STREAM=
