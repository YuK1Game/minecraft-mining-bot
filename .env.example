# Local account label; this is not your email or Xbox gamertag.
BOT_PROFILE=main
# Leave blank to select a Realm interactively each time.
REALM_ID=
# Leave blank to use the library default and server version discovery.
# If needed, use the supported protocol spelling, for example 1.26.51.
MINECRAFT_VERSION=
# The status API listens on 127.0.0.1 only.
API_PORT=3000
